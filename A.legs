#include<iostream>
using namespace std;
void solve(){
    long long n;
    cin>>n;
    if(n==2){
        cout<<1<<endl;
    }
    if(n>=4 && n%4==0){
        cout<<n/4<<endl;
    }
    if(n>=4 && n%4!=0 &&n%2==0){
        cout<<n/4+1<<endl;
    }


}
int main(){
    int t;
    cin>>t; 
    while(t--){
        solve();
    }
}
